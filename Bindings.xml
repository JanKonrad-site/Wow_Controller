<Bindings>
  <Binding name="OCTOPORT_MOVE_FORWARD" runOnUp="true" header="OCTOPORT">
    OctoPort_Move("forward", keystate)
  </Binding>
  <Binding name="OCTOPORT_MOVE_BACKWARD" runOnUp="true">
    OctoPort_Move("backward", keystate)
  </Binding>
  <Binding name="OCTOPORT_MOVE_LEFT" runOnUp="true">
    OctoPort_Move("left", keystate)
  </Binding>
  <Binding name="OCTOPORT_MOVE_RIGHT" runOnUp="true">
    OctoPort_Move("right", keystate)
  </Binding>
  <Binding name="OCTOPORT_ACTION_A" runOnUp="true">
    OctoPort_ActionKey(1, keystate)
  </Binding>
  <Binding name="OCTOPORT_ACTION_B" runOnUp="true">
    OctoPort_ActionKey(2, keystate)
  </Binding>
  <Binding name="OCTOPORT_ACTION_X" runOnUp="true">
    OctoPort_ActionKey(3, keystate)
  </Binding>
  <Binding name="OCTOPORT_ACTION_Y" runOnUp="true">
    OctoPort_ActionKey(4, keystate)
  </Binding>
  <Binding name="OCTOPORT_RADIAL" runOnUp="true">
    OctoPort_RadialKey(keystate)
  </Binding>
  <Binding name="OCTOPORT_TARGET_UP">
    OctoPort_Target("up")
  </Binding>
  <Binding name="OCTOPORT_TARGET_DOWN">
    OctoPort_Target("down")
  </Binding>
  <Binding name="OCTOPORT_TARGET_LEFT">
    OctoPort_Target("left")
  </Binding>
  <Binding name="OCTOPORT_TARGET_RIGHT">
    OctoPort_Target("right")
  </Binding>
  <Binding name="OCTOPORT_LAYER_LB" runOnUp="true">
    OctoPort_LayerKey("shift", keystate)
  </Binding>
  <Binding name="OCTOPORT_LAYER_LT" runOnUp="true">
    OctoPort_LayerKey("ctrl", keystate)
  </Binding>
  <Binding name="OCTOPORT_OPENCONFIG">
    OctoPort_OpenConfig()
  </Binding>
  <Binding name="OCTOPORT_REAR_M1" runOnUp="true">
    OctoPort_RearKey("M1", keystate)
  </Binding>
  <Binding name="OCTOPORT_REAR_M2" runOnUp="true">
    OctoPort_RearKey("M2", keystate)
  </Binding>
  <Binding name="OCTOPORT_TOGGLEBAGS">
    OctoPort_ToggleBags()
  </Binding>
  <Binding name="OCTOPORT_TOGGLEHELP">
    OctoPort_ToggleHelp()
  </Binding>
</Bindings>
